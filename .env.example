# Copy to .env in the repo root or to server/.env.
# Secrets stay on the server / Vercel env. Never put them in client code.

# Supabase Postgres connection string
# Project Settings → Database → Connection string → URI (use "Transaction" pooler for Vercel)



GROQ_API_KEY=
